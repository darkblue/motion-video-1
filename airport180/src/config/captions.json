[
  {
    "shot_id": "S01-SH01",
    "start": 0.25,
    "end": 6.78,
    "text": "以一个虚构的发展中国家为例：航空需求持续增长，现有机场年容量两千四百万人次，已经不够用了。"
  },
  {
    "shot_id": "S01-SH02",
    "start": 7.25,
    "end": 13.78,
    "text": "政府与机场业主提出建设议案，计划新建一座年旅客吞吐量六千万人次的国际机场。"
  },
  {
    "shot_id": "S01-SH03",
    "start": 14.25,
    "end": 16.732,
    "text": "建设议案进入论证与政府初步决策。"
  },
  {
    "shot_id": "S01-SH03",
    "start": 16.832,
    "end": 19.78,
    "text": "项目获准推进，不等于已经取得开工许可。"
  },
  {
    "shot_id": "S02-SH04",
    "start": 20.25,
    "end": 26.78,
    "text": "业主聘请专业咨询与设计机构，研究需求预测、选址、空域、环境和地面交通。"
  },
  {
    "shot_id": "S02-SH05",
    "start": 27.25,
    "end": 35.78,
    "text": "总体规划把跑道、滑行道、机坪和航站楼组织起来，协调空侧与陆侧的空间关系。"
  },
  {
    "shot_id": "S02-SH06",
    "start": 36.25,
    "end": 44.78,
    "text": "可行性研究、总体规划、概念设计和初步设计，逐步明确建设规模与技术方案。"
  },
  {
    "shot_id": "S03-SH07",
    "start": 45.25,
    "end": 50.138,
    "text": "咨询机构依据工程规模、设计和市场价格编制投资估算。"
  },
  {
    "shot_id": "S03-SH07",
    "start": 50.238,
    "end": 52.78,
    "text": "本案例暂按二十亿美元测算。"
  },
  {
    "shot_id": "S03-SH08",
    "start": 53.25,
    "end": 59.78,
    "text": "估算文件交给业主，用于预算审批、融资安排和投资决策，并随着项目推进更新。"
  },
  {
    "shot_id": "S03-SH09",
    "start": 60.25,
    "end": 64.78,
    "text": "初步估算、中标合同价和最终结算价，是三个不同数字，不能直接画上等号。"
  },
  {
    "shot_id": "S04-SH10",
    "start": 65.25,
    "end": 68.387,
    "text": "本片主线是设计、招标、施工的传统模式。"
  },
  {
    "shot_id": "S04-SH10",
    "start": 68.487,
    "end": 72.78,
    "text": "设计建造或EPC，则由承包商承担更多设计与施工责任。"
  },
  {
    "shot_id": "S04-SH11",
    "start": 73.25,
    "end": 81.78,
    "text": "业主按采购规则组织资格预审、发标、投标、评标与授标，比较技术、报价和履约能力。"
  },
  {
    "shot_id": "S04-SH12",
    "start": 82.25,
    "end": 85.886,
    "text": "业主分别与设计顾问、工程师和施工总承包商签约。"
  },
  {
    "shot_id": "S04-SH12",
    "start": 85.986,
    "end": 89.78,
    "text": "工程师依授权管理合同，并非施工合同的签约相对方。"
  },
  {
    "shot_id": "S04-SH13",
    "start": 90.25,
    "end": 92.465,
    "text": "总包提交图纸和技术文件，工程师审查并反馈。"
  },
  {
    "shot_id": "S04-SH13",
    "start": 92.565,
    "end": 94.78,
    "text": "文件流与管理权限，不能误画成施工合同关系。"
  },
  {
    "shot_id": "S05-SH14",
    "start": 95.25,
    "end": 97.88,
    "text": "合同签署后，各方按职责推进详细设计。"
  },
  {
    "shot_id": "S05-SH14",
    "start": 97.98,
    "end": 101.78,
    "text": "业主设计方负责主体设计，总包负责施工详图及约定设计。"
  },
  {
    "shot_id": "S05-SH15",
    "start": 102.25,
    "end": 109.072,
    "text": "航站楼需要协调建筑、结构、暖通、电气、给排水、消防、行李和信息系统。"
  },
  {
    "shot_id": "S05-SH15",
    "start": 109.172,
    "end": 111.78,
    "text": "BIM帮助多专业一起检查。"
  },
  {
    "shot_id": "S05-SH16",
    "start": 112.25,
    "end": 119.78,
    "text": "当风管与桥架发生碰撞，设计团队调整局部路径，保留接口位置，复查后消除冲突。"
  },
  {
    "shot_id": "S05-SH17",
    "start": 120.25,
    "end": 121.94,
    "text": "图纸提交、审查、批注、修订再报。"
  },
  {
    "shot_id": "S05-SH17",
    "start": 122.04,
    "end": 123.201,
    "text": "信息不清时发出RFI；"
  },
  {
    "shot_id": "S05-SH17",
    "start": 123.301,
    "end": 124.78,
    "text": "审查不免除提交方的合同责任。"
  },
  {
    "shot_id": "S06-SH18",
    "start": 125.25,
    "end": 132.78,
    "text": "采购前，供应商与总包准备技术数据、制造商建议、材料报审、符合性对照表和施工详图。"
  },
  {
    "shot_id": "S06-SH19",
    "start": 133.25,
    "end": 135.566,
    "text": "总包先审核，工程师按规范审查；"
  },
  {
    "shot_id": "S06-SH19",
    "start": 135.666,
    "end": 137.055,
    "text": "不符合就退回修改。"
  },
  {
    "shot_id": "S06-SH19",
    "start": 137.155,
    "end": 139.78,
    "text": "是否需要业主确认，取决于合同权限。"
  },
  {
    "shot_id": "S06-SH20",
    "start": 140.25,
    "end": 144.78,
    "text": "满足合同、技术规范、合格制造商名单和授权条件后，才能进入相应采购和生产。"
  },
  {
    "shot_id": "S07-SH21",
    "start": 145.25,
    "end": 152.78,
    "text": "土方、跑道、航站楼钢结构、屋面幕墙和机电安装，按照计划交叉推进，并接受质量检查。"
  },
  {
    "shot_id": "S07-SH22",
    "start": 153.25,
    "end": 160.78,
    "text": "设备进场后，行李、航显、安检与旅客处理设备安装到位，信息系统也开始部署。"
  },
  {
    "shot_id": "S07-SH23",
    "start": 161.25,
    "end": 166.683,
    "text": "机场运行数据库通过约定接口连接航显、行李、离港和安防系统。"
  },
  {
    "shot_id": "S07-SH23",
    "start": 166.783,
    "end": 169.78,
    "text": "单机、系统与跨系统联调逐级验证。"
  },
  {
    "shot_id": "S08-SH24",
    "start": 170.25,
    "end": 173.138,
    "text": "ORAT提前启动运营准备、人员培训和旅客流程演练。"
  },
  {
    "shot_id": "S08-SH24",
    "start": 173.238,
    "end": 175.78,
    "text": "测试验收、监管批准与移交，是不同的投运门槛。"
  },
  {
    "shot_id": "S08-SH25",
    "start": 176.25,
    "end": 178.261,
    "text": "达到启用条件后，新建机场正式投运。"
  },
  {
    "shot_id": "S08-SH25",
    "start": 178.361,
    "end": 179.78,
    "text": "从建设愿景，到正式起航。"
  }
]